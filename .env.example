# VITE_PLUG_CHAIN=arc-mainnet
# VITE_PLUG_ADDRESS=<mainnet contract>
# VITE_PLUG_DEPLOY_BLOCK=<mainnet deploy block>
# VITE_DEMO_AGENT_ADDRESS=<agent payout address>
